{
  "mcpServers": {
    "keeperhub": {
      "command": "node",
      "args": ["services/mcp/keeperhub-server.js"],
      "env": {
        "KEEPERHUB_API_KEY": "${KEEPERHUB_API_KEY}",
        "KEEPERHUB_BASE_URL": "${KEEPERHUB_BASE_URL:-https://app.keeperhub.com}",
        "KEEPERHUB_WALLET_PRIVATE_KEY": "${KEEPERHUB_WALLET_PRIVATE_KEY}",
        "KEEPERHUB_MARKVERIFIED_WORKFLOW_ID": "${KEEPERHUB_MARKVERIFIED_WORKFLOW_ID}"
      }
    }
  }
}
